{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-usage.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Skill|Task|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-usage.py\""
          }
        ]
      }
    ]
  }
}
