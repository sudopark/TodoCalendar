"eventDetail:todo:guide:process:message" = "जब दोहराव विकल्प चालू होता है, तो कार्य सामान्य अनुसूची से अलग व्यवहार करते हैं:";
"eventDetail:todo:guide:process:bullet1" = "वर्तमान या पिछले दोहराए जाने वाले कार्य जो अभी तक पूरे नहीं हुए हैं, कैलेंडर पर दिखाए जाते हैं।";
"eventDetail:todo:guide:process:bullet2" = "जब कोई कार्य पूरा हो जाता है, तो इवेंट पूर्ण इवेंट की सूची में जोड़ दिया जाता है और अगला दोहराव कैलेंडर में नया जोड़ा जाता है।";
"eventDetail:todo:guide:process:bullet3" = "यदि दोहराव समाप्ति समय के कारण कोई अगला दोहराव नहीं है, तो दोहराया जाने वाला कार्य समाप्त हो जाता है।";
"eventDetail:foremost:guide:message1" = "किसी इवेंट को सबसे महत्वपूर्ण के रूप में चिह्नित करें ताकि यह उजागर हो कि यह आपका सबसे महत्वपूर्ण इवेंट है।\nसबसे महत्वपूर्ण इवेंट हमेशा कैलेंडर में दिखाई देता है और एक अलग विजेट का समर्थन करता है।";
